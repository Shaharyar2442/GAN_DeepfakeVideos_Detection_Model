# ──────────────────────────────────────────────────────────────────
# VisionSnare Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to: GAN_DeepfakeVideos_Detection_Model/.env
# Fill in your own values. NEVER commit the actual .env to git.
# ──────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get it from: Atlas Dashboard → Connect → Drivers → Python
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/visionsnare
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/visionsnare

# JWT secret — any long random string works, keep it secret
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_long_random_string
